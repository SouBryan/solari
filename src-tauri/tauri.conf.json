{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solari",
  "version": "0.1.0",
  "identifier": "com.celestial.solari",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Solari — Assistente Google AI Pro",
        "width": 1024,
        "height": 740,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
